# Admin access: use a long, unique password and keep this file out of source control.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PASSWORD_SALT=

# Persistent SQLite database location (defaults to ./data/london-movers.sqlite).
DATABASE_PATH=

# SMTP settings for admin notifications and customer confirmations.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
ENQUIRY_TO=

# Canonical public site origin.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
